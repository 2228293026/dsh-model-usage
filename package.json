{
  "name": "@local/dsh-model-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "左侧栏「模型用量」面板：统计本机每个模型消耗的 Token 与请求数，并展示当前模型与已配置模型。",
  "keywords": ["dsh", "dsh-plugin", "usage", "tokens", "models"],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}